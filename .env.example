# ============================================================
# Configuración del MVP — copiar a .env  (cp .env.example .env)
# ============================================================

# --- Weaviate ---
WEAVIATE_HOST=localhost
WEAVIATE_HTTP_PORT=8081
WEAVIATE_GRPC_PORT=50052
WEAVIATE_COLLECTION=Normativa

# --- Modelos ---
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
NER_MODEL=urchade/gliner_multi-v2.1
NER_ENABLED=true

# --- HNSW (parámetros de índice) ---
HNSW_EF_CONSTRUCTION=256
HNSW_MAX_CONNECTIONS=32
HNSW_EF=128
HNSW_DYNAMIC_EF_FACTOR=2

# --- Generación de respuestas (opcional) ---
# Sin ninguna clave, el asistente responde en modo extractivo (fragmentos + citas).
# Se elige por prioridad: DeepSeek y, si no hay, Groq.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
# El modo thinking de DeepSeek viene activado por defecto; se desactiva para
# respuestas mas rapidas y deterministas en un asistente con contexto recuperado.
DEEPSEEK_THINKING=disabled

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Busqueda semantica / embeddings (opcional) ---
# Sin clave, la recuperacion usa solo BM25. Con clave y vectores del corpus, la
# busqueda pasa a ser hibrida (BM25 + coseno) con alpha = HYBRID_ALPHA.
# Los vectores se generan una vez con:
#   python -m scripts.export_embeddings_local      (recomendado, sin API)
#   python -m scripts.export_openai_embeddings     (por API)
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_DIMENSIONS=1024

# --- Reordenacion con cross-encoder (opcional) ---
# El modelo no cabe en una funcion serverless de Vercel (2,2 GB) ni cabe en el
# tiempo de una funcion en CPU (16 s por consulta), asi que en el modo nativo el
# rerank se delega en un proveedor externo. El cliente habla dos dialectos y
# deduce cual usar de la URL:
#
#   DeepInfra  POST /v1/inference/{modelo}   {queries:[...], documents:[...]}
#                                          -> {scores:[...]} EN EL ORDEN DE ENTRADA
#   Estandar   POST {url}  {model, query, documents, top_n}
#                                          -> {results:[{index, relevance_score}]}
#              (Jina, Cohere, Voyage, Text Embeddings Inference)
#
# Sin RERANK_API_URL el portal funciona igual, sin reordenar.
# Comparacion de proveedores y precios: docs/PROVEEDORES-RERANK.md
RERANK_API_URL=
RERANK_API_KEY=
# auto | estandar | deepinfra  (por defecto se deduce de la URL)
# RERANK_FORMATO=auto
# En DeepInfra el modelo puede ir en la propia URL; aqui solo hace falta si la
# URL termina en /inference. Por defecto: Qwen/Qwen3-Reranker-0.6B en DeepInfra
# y BAAI/bge-reranker-v2-m3 en el formato estandar.
# RERANK_MODEL=Qwen/Qwen3-Reranker-0.6B
# Candidatos que se recuperan antes de reordenar (se acota a 10-100)
RERANK_CANDIDATOS=30
# Poner "false" para desactivarlo aunque haya proveedor
# RERANK_ACTIVO=true
# Solo DeepInfra: instruccion que orienta la tarea
# RERANK_INSTRUCTION=Dada una consulta sobre normativa del Banco Central de Venezuela, recupera los articulos que la responden

# --- Fusion hibrida ---
# Peso de la componente semantica. 0.7 esta medido: con 0.5 el Art. 12 del
# Convenio Cambiario N. 1 no entraba entre los candidatos que ve el reranker y
# no habia forma de rescatarlo. Ver docs/RERANK.md.
HYBRID_ALPHA=0.7

# --- Ingesta ---
# Base del portal oficial
BCV_BASE_URL=https://www.bcv.org.ve
# Páginas/secciones del dominio jurídico a rastrear (documentos normativos)
USER_AGENT=BCV-VectorKnowledge-MVP/0.1 (asesoria tecnica; contacto: universidadfbf@gmail.com)
REQUEST_DELAY_SECONDS=1.0
VERIFY_SSL=false
